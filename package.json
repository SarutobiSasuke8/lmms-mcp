{
  "name": "@sarutobi-sasuke/lmms-mcp",
  "mcpName": "io.github.SarutobiSasuke8/lmms-mcp",
  "version": "0.9.1",
  "description": "MCP server that lets an AI agent compose, mix, measure and export game music with stock LMMS 1.2.2",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lmms",
    "music",
    "game-audio",
    "audio",
    "midi",
    "composition"
  ],
  "homepage": "https://github.com/SarutobiSasuke8/lmms-mcp#readme",
  "bugs": {
    "url": "https://github.com/SarutobiSasuke8/lmms-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SarutobiSasuke8/lmms-mcp.git"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "server.mjs",
    "fathom.mjs",
    "vst3-render.py",
    "compose-cli.mjs",
    "nightly.mjs",
    "library-server.mjs",
    "catalogue.mjs",
    "composers.mjs",
    "audio.mjs",
    "music.mjs",
    "effects.mjs",
    "tools/",
    "schema/",
    "!tools/*.test.mjs",
    "sound-catalogue.json",
    "skills/",
    "demo.mjs",
    "test.mjs",
    "verify-*.mjs",
    "docs/",
    "art/",
    "COMPARISON.md",
    "setup-windows.ps1",
    "setup-vst3-windows.ps1",
    "setup-vst3-linux.sh",
    "setup-libraries-windows.ps1",
    "CHANGELOG.md",
    "sampler/",
    "!sampler/test_*.py",
    "!sampler/check_*.py",
    "!**/__pycache__",
    "!**/*.pyc",
    "!**/*.pyo"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lmms-mcp": "server.mjs",
    "lmms-compose": "compose-cli.mjs"
  },
  "scripts": {
    "demo": "node demo.mjs",
    "test": "node .github/scripts/run-tests.mjs",
    "verify": "node verify-exports.mjs && node verify-game-audio.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tonejs/midi": "2.0.28",
    "@xmldom/xmldom": "0.9.12",
    "zod": "4.6.7"
  }
}
