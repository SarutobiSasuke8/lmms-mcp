{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SarutobiSasuke8/lmms-mcp",
  "title": "LMMS MCP",
  "description": "Compose, mix, measure and export music with LMMS.",
  "repository": {
    "url": "https://github.com/SarutobiSasuke8/lmms-mcp",
    "source": "github"
  },
  "version": "0.9.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@sarutobi-sasuke/lmms-mcp",
      "version": "0.9.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LMMS_WORKSPACE",
          "description": "Existing workspace directory for LMMS projects, renders and exports.",
          "isRequired": true,
          "isSecret": false
        }
      ]
    }
  ]
}
