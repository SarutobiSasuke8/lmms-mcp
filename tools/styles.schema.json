{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Composer style catalogue",
  "type": "object",
  "properties": {
    "styles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "about": {
            "type": "string",
            "minLength": 1
          },
          "bpm": {
            "type": "number",
            "minimum": 45,
            "maximum": 240
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "melody": {
            "type": "object",
            "properties": {
              "style": {
                "type": "string",
                "minLength": 1
              },
              "low": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "high": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "baseVelocity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "ornament": {
                "type": "boolean"
              },
              "dynamics": {
                "type": "number"
              }
            },
            "required": [
              "style",
              "low",
              "high",
              "baseVelocity"
            ],
            "additionalProperties": false
          },
          "harmony": {
            "type": "object",
            "properties": {
              "style": {
                "type": "string",
                "minLength": 1
              },
              "low": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "high": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "baseVelocity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "pedal": {
                "type": "boolean"
              },
              "echo": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "style",
              "low",
              "high",
              "baseVelocity"
            ],
            "additionalProperties": false
          },
          "pad": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "properties": {
                  "style": {
                    "type": "string",
                    "minLength": 1
                  },
                  "low": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  },
                  "high": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  },
                  "baseVelocity": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  },
                  "always": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "style",
                  "low",
                  "high",
                  "baseVelocity"
                ],
                "additionalProperties": false
              }
            ]
          },
          "bass": {
            "type": "string",
            "minLength": 1
          },
          "drums": {
            "type": "string",
            "minLength": 1
          },
          "siren": {
            "type": "boolean"
          },
          "dropout": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "voices": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "properties": {
                "voice": {
                  "type": "string",
                  "minLength": 1
                },
                "preset": {
                  "type": "string",
                  "minLength": 1
                },
                "factorySample": {
                  "type": "string",
                  "minLength": 1
                },
                "volume": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "pan": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                }
              },
              "required": [
                "voice"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "about",
          "bpm",
          "keys",
          "melody",
          "harmony",
          "bass",
          "drums",
          "voices"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "styles"
  ],
  "additionalProperties": false
}
